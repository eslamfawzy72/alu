@startuml
package cpu_pkg {
  enum alu_op_t {
    OP_SEL_B = 0
    OP_INC_B = 1
    OP_DEC_B = 2
    OP_ADD = 3
    OP_ADDC = 4
    OP_SUB = 5
    OP_SUBB = 6
    OP_AND = 7
    OP_OR = 8
    OP_XOR = 9
    OP_SHL = 10
    OP_SHR = 11
    OP_ROL = 12
    OP_ROR = 13
  }

  class base_alu {
    int operand_A
    int operand_B
    alu_op_t alu_op
    int alu_result
    +load_operand_A(int)
    +load_operand_B(int)
    +initialize()
    +display()
    +execute()
  }

  class logical_alu
  class arithmetic_alu
  class CPU {
    logical_alu l_alu
    arithmetic_alu a_alu
    +Reset()
    +Calc(int, int, alu_op_t) : int
  }

  logical_alu --|> base_alu
  arithmetic_alu --|> base_alu
  CPU *-- logical_alu
  CPU *-- arithmetic_alu
}
@enduml
