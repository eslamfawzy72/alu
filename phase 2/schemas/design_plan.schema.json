{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase 2 Design Plan",
  "type": "object",
  "required": [
    "plan_version",
    "spec_version",
    "mode",
    "units",
    "build_order",
    "added_elements"
  ],
  "properties": {
    "plan_version": {
      "type": "integer"
    },
    "spec_version": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "class_model",
        "hardware"
      ]
    },
    "units": {
      "type": "array"
    },
    "build_order": {
      "type": "array"
    },
    "added_elements": {
      "type": "array"
    }
  }
}
