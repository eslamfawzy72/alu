classDiagram
  class base_alu {
    +int operand_A
    +int operand_B
    +alu_op_t alu_op
    +int alu_result
    +load_operand_A()
    +load_operand_B()
    +initialize()
    +display()
    +get_name()
    +execute()
  }
  class logical_alu {
    +get_name()
    +execute()
  }
  class arithmetic_alu {
    +bit carry
    +get_name()
    +initialize()
    +get_carry()
    +set_carry()
    +display()
    +execute()
  }
  class CPU {
    +logical_alu l_alu
    +arithmetic_alu a_alu
    +Reset()
    +Calc()
  }
  base_alu <|-- logical_alu
  base_alu <|-- arithmetic_alu
  CPU *-- logical_alu : l_alu
  CPU *-- arithmetic_alu : a_alu
  note for CPU "all classes are included in cpu_pkg (cpu_pkg.sv) with alu_op_t"
