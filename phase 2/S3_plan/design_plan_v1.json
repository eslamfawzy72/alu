    {"name": "initialize", "signature": "virtual function void initialize()", "overrides": "base_alu", "behaviour": "super.initialize(); carry = 0", "decision": "D-007"},
    {"name": "get_carry", "signature": "function bit get_carry()", "behaviour": "returns carry", "decision": "D-016"},
    {"name": "set_carry", "signature": "function void set_carry(bit c)", "behaviour": "carry = c (lets a test set carry-in directly; named in alu_spec.json)", "decision": "D-005"},
    {"name": "display", "signature": "virtual function void display()", "overrides": "base_alu", "behaviour": "base line plus carry=<0/1>", "decision": "D-010"},
    {"name": "execute", "signature": "virtual function void execute()", "overrides": "base_alu", "behaviour": "case on alu_op over OP-001..OP-007; any other code reports $error"}
   ],
   "datapath": [
    {"op": "OP-001", "enum": "OP_SEL_B", "compute": "alu_result = operand_B", "carry": "unchanged"},
    {"op": "OP-002", "enum": "OP_INC_B", "compute": "alu_result = operand_B + 1 (wraps)", "carry": "unchanged"},
    {"op": "OP-003", "enum": "OP_DEC_B", "compute": "alu_result = operand_B - 1 (wraps)", "carry": "unchanged"},
    {"op": "OP-004", "enum": "OP_ADD",  "compute": "wide = a + b; alu_result = wide[31:0]", "carry": "wide[32]"},
    {"op": "OP-005", "enum": "OP_ADDC", "compute": "wide = a + b + cin; alu_result = wide[31:0]", "carry": "wide[32]"},
    {"op": "OP-006", "enum": "OP_SUB",  "compute": "wide = a - b; alu_result = wide[31:0]", "carry": "wide[32] (1 = borrow: unsigned A < B)"},
    {"op": "OP-007", "enum": "OP_SUBB", "compute": "wide = a - b - cin; alu_result = wide[31:0]", "carry": "wide[32] (borrow out)"}
   ],
   "locals": [
    {"name": "a, b", "type": "logic [32:0]", "value": "{1'b0, operand_A}, {1'b0, operand_B}", "why": "33-bit unsigned copies: bit 32 of the sum is the carry out, bit 32 of the difference is the borrow out (D-005, D-006)"},
    {"name": "cin", "type": "logic [32:0]", "value": "carry zero-extended", "why": "carry-in / borrow-in for ADDC and SUBB"},
    {"name": "wide", "type": "logic [32:0]", "value": "33-bit result", "why": "result plus carry/borrow in one value"}
   ],
