   ],
   "locals": [
    {"name": "a", "type": "int unsigned", "value": "operand_A as an unsigned 32-bit pattern", "why": "makes >> a logical shift (D-004) and rotates see plain bits"},
    {"name": "amt", "type": "int unsigned", "value": "operand_B[4:0], 0 to 31", "why": "shift/rotate amount (D-003)"}
   ],
