   "datapath": [
    {"op": "OP-008", "enum": "OP_AND", "compute": "alu_result = operand_A & operand_B"},
    {"op": "OP-009", "enum": "OP_OR",  "compute": "alu_result = operand_A | operand_B"},
    {"op": "OP-010", "enum": "OP_XOR", "compute": "alu_result = operand_A ^ operand_B"},
    {"op": "OP-011", "enum": "OP_SHL", "compute": "alu_result = a << amt"},
    {"op": "OP-012", "enum": "OP_SHR", "compute": "alu_result = a >> amt (logical: a is unsigned, so zeros fill)"},
    {"op": "OP-013", "enum": "OP_ROL", "compute": "alu_result = (a << amt) | (a >> (32 - amt)); amt = 0 gives a >> 32 = 0, so the result is a"},
