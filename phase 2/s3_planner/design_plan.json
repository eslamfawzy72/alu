{
  "plan_version": 1,
  "spec_version": "phase1.0-normalized",
  "mode": "class_model",
  "language": "SystemVerilog",
  "design_kind": "simulation-only class model",
  "units": [
    {
      "name": "cpu_pkg",
      "kind": "package",
      "file": "rtl/cpu_pkg.sv",
      "owns": [
        "FR-011",
        "FR-012",
        "FR-013",
        "IF-013",
        "IF-014",
        "D-001",
        "D-014"
      ],
      "responsibility": "Provide the shared operation enum and package the CPU/ALU class definitions."
    },
    {
      "name": "base_alu",
      "kind": "class",
      "file": "rtl/base_alu.svh",
      "owns": [
        "FR-001",
        "FR-002",
        "FR-003",
        "FR-004",
        "FR-005",
        "IF-001",
        "IF-002",
        "IF-003",
        "IF-004",
        "IF-005",
        "IF-006",
        "IF-007",
        "IF-008",
        "D-007",
        "D-010",
        "D-011",
        "D-013"
      ],
      "state": [
        {
          "name": "operand_A",
          "type": "int",
          "reset": 0
        },
        {
          "name": "operand_B",
          "type": "int",
          "reset": 0
        },
        {
          "name": "alu_op",
          "type": "alu_op_t",
          "reset": "OP_SEL_B"
        },
        {
          "name": "alu_result",
          "type": "int",
          "reset": 0
        }
      ],
      "methods": [
        "function void load_operand_A(input int value)",
        "function void load_operand_B(input int value)",
        "function void initialize()",
        "function void display()",
        "virtual function void execute()"
      ]
    },
    {
      "name": "arithmetic_alu",
      "kind": "class",
      "file": "rtl/arithmetic_alu.svh",
      "extends": "base_alu",
      "owns": [
        "FR-007",
        "OP-001",
        "OP-002",
        "OP-003",
        "OP-004",
        "OP-005",
        "OP-006",
        "OP-007",
        "D-002",
        "D-005",
        "D-006",
        "D-016",
        "D-017"
      ],
      "state": [
        {
          "name": "carry",
          "type": "bit",
          "reset": 0,
          "from": "D-005"
        },
        {
          "name": "borrow",
          "type": "bit",
          "reset": 0,
          "from": "D-006"
        }
      ],
      "datapath": [
        {
          "op": "OP-004",
          "compute": "wide[32:0] = {0,A} + {0,B}",
          "result": "wide[31:0]",
          "carry_out": "wide[32]"
        },
        {
          "op": "OP-005",
          "compute": "wide[32:0] = {0,A} + {0,B} + carry",
          "result": "wide[31:0]",
          "carry_out": "wide[32]"
        },
        {
          "op": "OP-006",
          "compute": "wide = {0,A} - {0,B}",
          "result": "wide[31:0]",
          "borrow_out": "A < B"
        },
        {
          "op": "OP-007",
          "compute": "wide = {0,A} - {0,B} - borrow",
          "result": "wide[31:0]",
          "borrow_out": "A < B + borrow"
        }
      ],
      "methods": [
        "override virtual function void execute()"
      ]
    },
    {
      "name": "logical_alu",
      "kind": "class",
      "file": "rtl/logical_alu.svh",
      "extends": "base_alu",
      "owns": [
        "FR-006",
        "OP-008",
        "OP-009",
        "OP-010",
        "OP-011",
        "OP-012",
        "OP-013",
        "OP-014",
        "D-002",
        "D-003",
        "D-004"
      ],
      "state": [],
      "datapath": [
        {
          "op": "OP-008",
          "compute": "A & B",
          "result": "alu_result"
        },
        {
          "op": "OP-009",
          "compute": "A | B",
          "result": "alu_result"
        },
        {
          "op": "OP-010",
          "compute": "A ^ B",
          "result": "alu_result"
        },
        {
          "op": "OP-011",
          "compute": "A << B[4:0]",
          "result": "alu_result"
        },
        {
          "op": "OP-012",
          "compute": "unsigned(A) >> B[4:0]",
          "result": "alu_result"
        },
        {
          "op": "OP-013",
          "compute": "32-bit rotate-left A by B[4:0]",
          "result": "alu_result"
        },
        {
          "op": "OP-014",
          "compute": "32-bit rotate-right A by B[4:0]",
          "result": "alu_result"
        }
      ],
      "methods": [
        "override virtual function void execute()"
      ]
    },
    {
      "name": "CPU",
      "kind": "class",
      "file": "rtl/CPU.svh",
      "owns": [
        "FR-008",
        "FR-009",
        "FR-010",
        "IF-009",
        "IF-010",
        "IF-011",
        "IF-012",
        "D-008",
        "D-009",
        "D-012",
        "D-018"
      ],
      "contains": [
        {
          "name": "l_alu",
          "type": "logical_alu"
        },
        {
          "name": "a_alu",
          "type": "arithmetic_alu"
        }
      ],
      "control": {
        "kind": "opcode dispatch",
        "rule": "0000-0110 -> a_alu; 0111-1101 -> l_alu; 1110-1111 -> invalid policy"
      },
      "methods": [
        "function new()",
        "function void Reset()",
        "function int Calc(input int in1, input int in2, input alu_op_t operation)"
      ]
    }
  ],
  "build_order": [
    "rtl/cpu_pkg.sv",
    "rtl/base_alu.svh",
    "rtl/logical_alu.svh",
    "rtl/arithmetic_alu.svh",
    "rtl/CPU.svh",
    "tb/tb_alu.sv"
  ],
  "global_rules": {
    "one_class_per_file": true,
    "extern_methods": true,
    "int_is_32_bit_signed": true,
    "no_clocked_logic": true,
    "no_hardware_synthesis_target": true,
    "invalid_opcode_policy": "return 0 and issue warning"
  },
  "added_elements": [
    {
      "name": "execute()",
      "reason": "Common virtual dispatch point for derived ALU classes.",
      "decision": "D-013",
      "approval": "provisionally approved for Phase 2 implementation"
    },
    {
      "name": "arithmetic_alu.carry",
      "reason": "State needed to make ADD with CARRY deterministic without changing Calc signature.",
      "decision": "D-005",
      "approval": "provisionally approved"
    },
    {
      "name": "arithmetic_alu.borrow",
      "reason": "State needed to make SUB with BORROW deterministic without changing Calc signature.",
      "decision": "D-006",
      "approval": "provisionally approved"
    }
  ]
}
