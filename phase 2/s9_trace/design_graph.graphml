<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd"><key id="d2" for="edge" attr.name="relation" attr.type="string"/>
<key id="d1" for="node" attr.name="file" attr.type="string"/>
<key id="d0" for="node" attr.name="kind" attr.type="string"/>
<graph edgedefault="directed"><node id="cpu_pkg">
  <data key="d0">package</data>
  <data key="d1">rtl/cpu_pkg.sv</data>
</node>
<node id="base_alu">
  <data key="d0">class</data>
  <data key="d1">rtl/base_alu.svh</data>
</node>
<node id="arithmetic_alu">
  <data key="d0">class</data>
  <data key="d1">rtl/arithmetic_alu.svh</data>
</node>
<node id="logical_alu">
  <data key="d0">class</data>
  <data key="d1">rtl/logical_alu.svh</data>
</node>
<node id="CPU">
  <data key="d0">class</data>
  <data key="d1">rtl/CPU.svh</data>
</node>
<node id="l_alu"/>
<node id="a_alu"/>
<node id="tb_alu"/>
<edge source="arithmetic_alu" target="base_alu">
  <data key="d2">extends</data>
</edge>
<edge source="logical_alu" target="base_alu">
  <data key="d2">extends</data>
</edge>
<edge source="CPU" target="l_alu">
  <data key="d2">contains</data>
</edge>
<edge source="CPU" target="a_alu">
  <data key="d2">contains</data>
</edge>
<edge source="tb_alu" target="CPU">
  <data key="d2">instantiates</data>
</edge>
</graph></graphml>