  "operations": [
    {
      "id": "OP-001",
      "name": "Select data on port B",
      "enum": "OP_SEL_B",
      "code": "4'b0000",
      "alu": "arithmetic",
      "semantics": "result = B",
      "updates_carry": false
    },
    {
      "id": "OP-002",
      "name": "Increment data on port B",
      "enum": "OP_INC_B",
      "code": "4'b0001",
      "alu": "arithmetic",
      "semantics": "result = B + 1 (wraps)",
      "updates_carry": false
    },
    {
      "id": "OP-003",
      "name": "Decrement data on port B",
      "enum": "OP_DEC_B",
      "code": "4'b0010",
      "alu": "arithmetic",
      "semantics": "result = B - 1 (wraps)",
      "updates_carry": false
    },
    {
      "id": "OP-004",
      "name": "ADD without CARRY",
      "enum": "OP_ADD",
      "code": "4'b0011",
      "alu": "arithmetic",
      "semantics": "result = A + B; carry = unsigned carry out",
      "updates_carry": true
    },
    {
      "id": "OP-005",
      "name": "ADD with CARRY",
      "enum": "OP_ADDC",
      "code": "4'b0100",
      "alu": "arithmetic",
      "semantics": "result = A + B + carry; carry = unsigned carry out",
      "updates_carry": true
    },
    {
      "id": "OP-006",
      "name": "SUB without BORROW",
      "enum": "OP_SUB",
      "code": "4'b0101",
      "alu": "arithmetic",
      "semantics": "result = A - B; carry = borrow out",
      "updates_carry": true
    },
    {
      "id": "OP-007",
      "name": "SUB with BORROW",
      "enum": "OP_SUBB",
      "code": "4'b0110",
      "alu": "arithmetic",
      "semantics": "result = A - B - carry; carry = borrow out",
      "updates_carry": true
    },
    {
      "id": "OP-008",
      "name": "AND",
      "enum": "OP_AND",
      "code": "4'b0111",
      "alu": "logical",
      "semantics": "result = A & B",
      "updates_carry": false
    },
    {
      "id": "OP-009",
      "name": "OR",
      "enum": "OP_OR",
      "code": "4'b1000",
      "alu": "logical",
      "semantics": "result = A | B",
      "updates_carry": false
    },
    {
      "id": "OP-010",
      "name": "XOR",
      "enum": "OP_XOR",
      "code": "4'b1001",
      "alu": "logical",
      "semantics": "result = A ^ B",
      "updates_carry": false
    },
    {
      "id": "OP-011",
      "name": "Shift left",
      "enum": "OP_SHL",
      "code": "4'b1010",
      "alu": "logical",
      "semantics": "result = A << B[4:0]",
      "updates_carry": false
    },
    {
      "id": "OP-012",
      "name": "Shift right",
      "enum": "OP_SHR",
      "code": "4'b1011",
      "alu": "logical",
      "semantics": "result = A >> B[4:0] (logical, zero fill)",
      "updates_carry": false
    },
    {
      "id": "OP-013",
      "name": "Rotate left",
      "enum": "OP_ROL",
      "code": "4'b1100",
      "alu": "logical",
      "semantics": "result = A rotated left by B[4:0] within 32 bits",
      "updates_carry": false
    },
    {
      "id": "OP-014",
      "name": "Rotate right",
      "enum": "OP_ROR",
      "code": "4'b1101",
      "alu": "logical",
      "semantics": "result = A rotated right by B[4:0] within 32 bits",
      "updates_carry": false
    }
  ],
